<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>

    <!-- Directory for all file appenders (override in application-*.properties: billing.log.directory=logs) -->
    <springProperty scope="context" name="BILLING_LOG_DIR" source="billing.log.directory" defaultValue="logs"/>

    <!--
      CONSOLE is defined ONCE and referenced by every profile.
      Previously, springProfile "!local" had only <root level="INFO"/> with NO appender-ref,
      which replaced the root logger and dropped ALL appenders → zero logs on dev profile.
    -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{50} - %msg%n%wEx</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- local: console + rolling files under ${BILLING_LOG_DIR} -->
    <springProfile name="local">
        <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
            <file>${BILLING_LOG_DIR}/billing.log</file>
            <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
                <fileNamePattern>${BILLING_LOG_DIR}/billing.%d{yyyy-MM-dd}.log</fileNamePattern>
                <maxHistory>30</maxHistory>
            </rollingPolicy>
            <encoder>
                <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{50} - %msg%n%wEx</pattern>
                <charset>UTF-8</charset>
            </encoder>
        </appender>

        <appender name="ERROR_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
            <file>${BILLING_LOG_DIR}/billing-error.log</file>
            <filter class="ch.qos.logback.classic.filter.ThresholdFilter">
                <level>ERROR</level>
            </filter>
            <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
                <fileNamePattern>${BILLING_LOG_DIR}/billing-error.%d{yyyy-MM-dd}.log</fileNamePattern>
                <maxHistory>30</maxHistory>
            </rollingPolicy>
            <encoder>
                <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{50} - %msg%n%wEx</pattern>
                <charset>UTF-8</charset>
            </encoder>
        </appender>

        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
            <appender-ref ref="FILE"/>
            <appender-ref ref="ERROR_FILE"/>
        </root>
        <logger name="com.app.billing" level="DEBUG"/>
    </springProfile>

    <!-- dev, prod, server: console + billing.log + billing-dev.log (same content in both files) -->
    <springProfile name="!local">
        <appender name="FILE_BILLING" class="ch.qos.logback.core.rolling.RollingFileAppender">
            <file>${BILLING_LOG_DIR}/billing.log</file>
            <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
                <fileNamePattern>${BILLING_LOG_DIR}/billing.%d{yyyy-MM-dd}.log</fileNamePattern>
                <maxHistory>14</maxHistory>
            </rollingPolicy>
            <encoder>
                <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{50} - %msg%n%wEx</pattern>
                <charset>UTF-8</charset>
            </encoder>
        </appender>

        <appender name="FILE_BILLING_DEV" class="ch.qos.logback.core.rolling.RollingFileAppender">
            <file>${BILLING_LOG_DIR}/billing-dev.log</file>
            <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
                <fileNamePattern>${BILLING_LOG_DIR}/billing-dev.%d{yyyy-MM-dd}.log</fileNamePattern>
                <maxHistory>14</maxHistory>
            </rollingPolicy>
            <encoder>
                <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{50} - %msg%n%wEx</pattern>
                <charset>UTF-8</charset>
            </encoder>
        </appender>

        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
            <appender-ref ref="FILE_BILLING"/>
            <appender-ref ref="FILE_BILLING_DEV"/>
        </root>
        <logger name="com.app.billing" level="DEBUG"/>
    </springProfile>
</configuration>
